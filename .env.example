# Config del proyecto de Firebase (Configuración del proyecto > Tus apps > SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poné esto en "true" para testear localmente contra los Firebase Emulators
# (npm run emulators) en vez del proyecto real. Con esto en "true" no hace
# falta completar las variables de arriba.
VITE_USE_FIREBASE_EMULATOR=false
